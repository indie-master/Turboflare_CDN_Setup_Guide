# Dedicated domain delegated to TurboFlare.
DOMAIN=vpn.example.com

# Public IPv4 address of the origin server. 203.0.113.0/24 is documentation-only.
ORIGIN_IP=203.0.113.10
ORIGIN_PORT=443

# Local Nginx TLS vhost behind the public stream/SNI router.
NGINX_INTERNAL_PORT=8443

# Local Xray VLESS XHTTP inbound managed by Remnawave Node.
XRAY_LISTEN_IP=127.0.0.1
XRAY_XHTTP_PORT=40112
XRAY_INBOUND_TAG=xHTTP-TurboFlare
XHTTP_PATH=/static/getFile/video/segment.ts

# Self-signed certificate used only between TurboFlare and the origin.
ORIGIN_CERT_DAYS=3650

# Static cover site.
COVER_ROOT=/var/www/turboflare-cover
COVER_TITLE="Service is online"

# A file with map entries included from the existing Nginx stream map.
STREAM_MAP_DIR=/etc/nginx/stream-map.d
STREAM_MAP_FILE=turboflare.map

# Documentation/checklist labels for Remnawave.
CONFIG_PROFILE_NAME=CONFIG_PROFILE
SQUAD_NAME=TurboFlare-Test
